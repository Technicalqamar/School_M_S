# Server
PORT=
NODE_ENV=

# Database
MONGO_URI=

# Admin Seeder Configuration
ADMIN_FULL_NAME=System Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=

# Default Portal Password Encryption
# Optional. Used to encrypt the Admin-configured Student/Teacher default
# passwords at rest. If left empty, the encryption key falls back to
# JWT_SECRET. Provide a dedicated value in production and keep it stable:
# changing it makes previously stored default passwords undecryptable.
DEFAULT_PASSWORD_SECRET=

# Email (Nodemailer)
EMAIL_USER=
EMAIL_PASS=


# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# WhatsApp API (QR-based provider)
WHATSAPP_API_TOKEN=

# WhatsApp API Token Encryption
# Optional. Used to encrypt the Admin-configured WhatsApp API token at rest.
# If left empty, the encryption key falls back to JWT_SECRET (the fallback is
# reported once in the server log, naming the variables only). Provide a
# dedicated value in production and keep it stable: changing it makes the
# stored token undecryptable.
WHATSAPP_TOKEN_ENCRYPTION_SECRET=

# Public backend API base URL
# Optional. Used to build the temporary public image URL that is sent to the
# WhatsApp provider for Homework Diary images. Include the API prefix, e.g.
# https://api.example.com/api/v1. When empty, the URL is derived from the
# incoming admin request (including X-Forwarded-Proto/Host). A localhost URL is
# rejected because the WhatsApp provider cannot reach it.
PUBLIC_API_URL=

# Incoming WhatsApp Webhook
# Dedicated shared secret used to verify the `X-Webhook-Signature` header
# (HMAC-SHA256 over the exact raw request body). This is NOT the API token and
# the API token is never used as a fallback. While this value is empty the
# webhook endpoint fails closed and rejects every delivery with 503, so an
# unsigned message can never be accepted.
#
# The provider's exact signing contract (header format, whether a `sha256=`
# prefix is used, and where the secret is issued) must be confirmed before this
# is enabled in production.
WHATSAPP_WEBHOOK_SECRET=

# Incoming WhatsApp replies (Phase 3B)
# Set to `true` only after the provider payload and signature contract is
# confirmed. While empty/false, signed deliveries are still verified and
# deduplicated, but guardian matching, data lookup and outbound replies are
# disabled. Replies reuse the Admin-configured API token above.
WHATSAPP_WEBHOOK_PROCESSING_ENABLED=
